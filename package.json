{
  "name": "@marshwallen/dsh-desktop-restart",
  "version": "0.5.0",
  "description": "DeepSeek Harness desktop restart plugin with a single sidebar button below More, guarded restart, optional session resume and temp snapshot cleanup. 桌面版重启插件：仅在左侧边栏「更多」下方显示重启按钮，保留重启守卫、可选续跑与临时快照清理。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "restart",
    "desktop",
    "electron"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "README.en.md"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.1"
  },
  "scripts": {
    "test": "node scripts/smoke.mjs",
    "prepublishOnly": "npm test",
    "build": "node scripts/build.mjs",
    "smoke:archive": "node scripts/smoke-archive.mjs",
    "prepack": "npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "author": "marshwallen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marshwallen/dsh-desktop-restart.git"
  },
  "bugs": {
    "url": "https://github.com/marshwallen/dsh-desktop-restart/issues"
  },
  "homepage": "https://github.com/marshwallen/dsh-desktop-restart#readme",
  "contributors": [
    {
      "name": "luoshuizhiwei",
      "url": "https://github.com/luoshuizhiwei"
    }
  ]
}
